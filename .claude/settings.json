{
  "permissions": {
    "allow": [
      "git status",
      "git diff",
      "git log",
      "git add",
      "git commit",
      "git checkout -b",
      "git branch",
      "git stash",
      "git stash pop",
      "ls",
      "find",
      "cat",
      "head",
      "tail",
      "wc",
      ".venv\\Scripts\\python.exe -m pytest",
      ".venv\\Scripts\\python.exe -m pip install -r requirements.txt",
      ".venv\\Scripts\\python.exe -m pip list",
      ".venv\\Scripts\\python.exe -m ruff check",
      ".venv\\Scripts\\python.exe -m ruff format"
    ],
    "deny": [
      "rm -rf /",
      "rm -rf ~",
      "rm -rf .",
      "rm -rf *",
      "git push --force",
      "git push -f",
      "git reset --hard",
      "git clean -f",
      "git clean -fd",
      "git checkout -- .",
      "git branch -D main",
      "git branch -D develop",
      "sudo",
      "su -",
      "chmod 777",
      "chmod -R 777",
      "DROP TABLE",
      "DROP DATABASE",
      "TRUNCATE",
      "ssh ",
      "scp ",
      "curl | bash",
      "curl | sh",
      "wget | bash",
      "wget | sh",
      "npm install -g",
      "pip install --break-system-packages",
      "python -m http.server",
      "ngrok",
      "localtunnel",
      "osascript",
      "defaults write",
      "shutdown",
      "reboot",
      "kill -9",
      "killall",
      "eval ",
      "exec ",
      "cat .env",
      "type .env",
      "Get-Content .env"
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  }
}
