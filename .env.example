# Copy this file to .env and fill in the real value.
# NEVER commit .env — it is listed in .gitignore.

# ElevenLabs API key, used for Scribe v2 speech-to-text.
# Get one at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional. Only the rewrite mode uses it — dictation works without it, and with it
# absent that mode pastes the raw transcript and says so.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Set to true only while debugging — it writes the full transcript
# (your own speech) into logs/voice_typer.log. Off by default for privacy.
LOG_TRANSCRIPTS=false
